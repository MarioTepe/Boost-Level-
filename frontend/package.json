{
  "name": "boost-level-frontend",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "format": "prettier --write src vite.config.js index.html",
    "format:check": "prettier --check src vite.config.js index.html",
    "lint": "oxlint --deny-warnings src",
    "test": "vitest",
    "test:ejecutar": "vitest run",
    "test:cobertura": "vitest run --coverage"
  },
  "dependencies": {
    "bootstrap": "5.3.8",
    "react": "19.3.0",
    "react-bootstrap": "2.10.10",
    "react-dom": "19.3.0",
    "react-router": "8.4.0"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "jsdom": "30.1.3",
    "oxlint": "1.85.0",
    "prettier": "3.9.10",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
